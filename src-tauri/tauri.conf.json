{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Niazi Mobile Mart",
  "version": "1.2.20",
  "identifier": "com.bazi.niazimobilemart",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Niazi Mobile Mart",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGRUREODE0OEVBQUM2NTIKUldSU3hxcU9GTmp0LzNDN095MnhndU1jQXhKK2V1K2hMeTZlTjhIdW5MVXhVcEJ1THlQYUYwdDcK",
      "endpoints": [
        "https://github.com/bazistudio/niazi-mobile-mart/releases/latest/download/latest.json"
      ]
    }
  }
}
