# Niazi AI Assistant Environment Template
# NEVER commit real API keys or secrets to Git.

# Local Ollama Provider Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=60000

# Custom OpenAI-Compatible Provider Configuration
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=your-api-key-here
OPENAI_COMPATIBLE_TIMEOUT_MS=30000

# Assistant Runtime Environment
NODE_ENV=development
LOG_LEVEL=info

