# Niazi Mobile Mart - Production Environment Configuration Example
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT SECURITY NOTICE:
# Never commit real credentials, passwords, or token secrets to version control.
# All values shown below are safe placeholders for production runtime configuration.
# ─────────────────────────────────────────────────────────────────────────────

# Server Listener Port (Cloud Run default is 8080)
PORT=8080

# Production PostgreSQL Database Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://niazi_user:DATABASE_PASSWORD_PLACEHOLDER@10.0.0.3:5432/niazi_mobile_mart?sslmode=require

# Application Secret Key for JWT Token Generation / Verification
# Generate a strong 256-bit random string for production deployment platform secrets manager
TOKEN_SECRET=REPLACE_WITH_PRODUCTION_256_BIT_SECRET_TOKEN

# Rust Logging Verbosity (e.g., 'info', 'warn', 'error', 'debug', or module-specific filtering)
RUST_LOG=info

# Web Application Environment Mode ('production' | 'development')
VITE_APP_ENV=production
